{
  "expo": {
    "name": "PCR Narrative",
    "slug": "pcr-narrative-assistant",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pcrnarrative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.pcrnarrative",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.personal.pcrnarrative",
      "adaptiveIcon": {
        "backgroundColor": "#0B1B2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "PCR Narrative",
      "shortName": "PCR",
      "themeColor": "#0B1B2B",
      "backgroundColor": "#0B1B2B",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1B2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "PCR Narrative records audio only while you explicitly start a recording, so it can be transcribed into a patient care report narrative. Recordings stay on this device."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "PCR Narrative uses Face ID to unlock the app so patient care report drafts are not readable by anyone who picks up your phone."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "baseUrl": "/PCR911"
    }
  }
}
